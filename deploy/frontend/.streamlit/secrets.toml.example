# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Cloud secrets box.
# All three are optional: without them the app runs as the public, watermarked demo.

# Typed into the sidebar by whoever should get clean output.
ENGINE_TOKEN = "<python -c 'import secrets; print(secrets.token_urlsafe(32))'>"
# Derives every surrogate. Losing it breaks consistency with earlier runs.
KYCPSEUDO_HMAC_KEY = "<python -c 'import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'>"
# Encrypts the vault. Losing it makes vaults unreadable.
KYCPSEUDO_VAULT_KEY = "<python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'>"
